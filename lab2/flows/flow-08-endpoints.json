    {
        "id": "0d23bad2f9f89edf",
        "type": "function",
        "z": "91d992b8e92c2d83",
        "name": "function 3",
        "func": "// Получаем query-параметр id \nlet id = msg.req.query.id;\n\nif (!id) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"Bad Request: missing 'id' parameter\" };\n} else if (id > 10) {\n    msg.statusCode = 404;\n    msg.payload = { error: \"Not Found: item does not exist\" };\n} else {\n    msg.statusCode = 200;\n    msg.payload = { itemId: id, name: \"Товар #\" + id, status: \"available\" };\n}\nreturn msg;\n",
